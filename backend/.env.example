# Copy this file to ".env" and fill in real values before running the server.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_rating_db?schema=public"

# Server
PORT=5000
NODE_ENV=development

# CORS - the URL your frontend runs on
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
